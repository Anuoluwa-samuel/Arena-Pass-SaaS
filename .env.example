# ---- Application -----------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:4000
APP_NAME="Arena Pass"

# Domain that arena subdomains hang off: https://{arena-slug}.{APP_ROOT_DOMAIN}
# Leave unset to use the host from APP_URL, which is what a single-arena
# deployment wants. A request whose hostname matches no arena is refused
# rather than served the first arena in the database — except while the
# database holds exactly one arena, which keeps a fresh install working.
APP_ROOT_DOMAIN=


# ---- Database --------------------------------------------------------------
# Leave DATABASE_URL empty to use the embedded Postgres (PGlite) stored in
# PGLITE_DATA_DIR. Set a real Postgres URL for staging/production.
DATABASE_URL=
PGLITE_DATA_DIR=./.data/pglite

# ---- Secrets (generate with: openssl rand -hex 32) -------------------------
SESSION_SECRET=

# Encrypts credentials stored in the database that must be read back, such as
# each arena's payment provider keys. Required in production; falls back to
# SESSION_SECRET in development. Rotating it makes stored keys unreadable, so
# arenas must reconnect their payment accounts.
CREDENTIALS_KEY=
QR_SECRET=
CRON_SECRET=

# ---- Payments --------------------------------------------------------------
# mock (development only) | paystack
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ---- Media storage ---------------------------------------------------------
# local (disk) | blob (Vercel Blob; required on Vercel). Connecting a store in Vercel sets BLOB_STORE_ID (OIDC);
# BLOB_READ_WRITE_TOKEN is only needed outside Vercel.
STORAGE_DRIVER=local
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_BYTES=5242880

# ---- Google sign-in (optional) ---------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client
# ID (type "Web application"). Authorised redirect URI must be exactly:
#   <APP_URL>/api/auth/customer/google/callback
# "Continue with Google" stays hidden until both values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Email -----------------------------------------------------------------
# console (logs emails) | resend
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Arena Pass <no-reply@example.com>"

# ---- Observability ---------------------------------------------------------
LOG_LEVEL=info
